HOST=127.0.0.1
PORT=3333

# Use "mock" for the existing JSON development bridge or
# "local-faster-whisper" for real multipart transcription.
TRANSCRIPTION_PROVIDER=mock
LOCAL_WHISPER_URL=http://127.0.0.1:8001
TRANSCRIPTION_TIMEOUT_MS=120000
MAX_AUDIO_UPLOAD_BYTES=25165824

# Structured generation provider. "local" is deterministic and free.
# "openai" requires both OPENAI_API_KEY and OPENAI_GENERATION_MODEL.
GENERATION_PROVIDER=local
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=
GENERATION_TIMEOUT_MS=15000
