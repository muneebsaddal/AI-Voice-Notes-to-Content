{
  "name": "ai-voice-notes-to-content",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:dev": "npm run backend:build && node backend/dist/src/server.js",
    "backend:start": "node backend/dist/src/server.js",
    "backend:test": "npm run backend:build && node --test --experimental-test-isolation=none backend/dist/test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run backend:test"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/metro-runtime": "^56.0.13",
    "@expo/vector-icons": "^15.1.1",
    "expo": "^56.0.8",
    "expo-font": "^56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "typescript": "^6.0.3"
  }
}
